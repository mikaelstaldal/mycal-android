<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
    </cloud-backup>
    <device-transfer>
        <!--
           Exclude the EncryptedSharedPreferences file. Its Tink keysets are wrapped by
           an AndroidKeyStore master key, which never leaves the device, so the file
           cannot be decrypted on the target device after migration. Transferring it
           would cause EncryptedSharedPreferences.create() to throw on first launch.
        -->
        <exclude domain="sharedpref" path="secret_shared_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
